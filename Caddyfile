:{$PORT:8080}

root src

# Map Accept-Language header to language prefixes
map {header.Accept-Language} {lang_prefix} {
	~(?i)zh-hant  /zh-hant
	~(?i)zh-tw    /zh-hant
	~(?i)zh-hk    /zh-hant
	~(?i)zh-mo    /zh-hant
	~(?i)zh       /zh-hans
	~(?i)vi       /vi
	~(?i)es       /es
	~(?i)fr       /fr
	~(?i)de       /de
	~(?i)ja       /ja
	~(?i)pt       /pt
	~(?i)ru       /ru
	~(?i)ko       /ko
	~(?i)it       /it
	default       ""
}

# Automatically redirect root visitors to their preferred language.
@autoRedirect {
	expression {lang_prefix} != ""
	path /
}
redir @autoRedirect {lang_prefix}/docs/ 302

file_server {
	disable_canonical_uris
}
templates {
	extensions {
		# Uncomment this if you have the caddy-hitcounter plugin (https://github.com/mholt/caddy-hitcounter):
		# hitCounter {
		# 	style bright_green
		# 	pad_digits 6
		# }
	}
}
encode zstd gzip

rewrite / /docs/index.html

@officialSite path_regexp officialSite ^/(features|download|account|support|sponsor)(/.*)?$
redir @officialSite https://caddyserver.com{uri} 302

# allow direct access to markdown but otherwise
# rewrite to docs index page to render it
# matches /docs/* and /{locale}/docs/* for any locale
@notDirectDocsMarkdown {
	path_regexp ^(/[a-z][a-z-]*)?/docs/
	not path *.md
	not path /api/*
}
rewrite @notDirectDocsMarkdown /docs/index.html

redir /docs/caddyfile/directives/basicauth /docs/caddyfile/directives/basic_auth 308
redir /docs/caddyfile/directives/skip_log /docs/caddyfile/directives/log_skip 308

reverse_proxy /api/* https://caddyserver.com {
	header_up Host caddyserver.com
}
